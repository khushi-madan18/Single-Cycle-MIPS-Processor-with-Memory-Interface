// Word address : Instruction
20080005 // 0  : ADDI $t0, $zero, 5      -> $t0 = 5
2009000A // 1  : ADDI $t1, $zero, 10     -> $t1 = 10
01095020 // 2  : ADD  $t2, $t0, $t1      -> $t2 = 15
AC0A0000 // 3  : SW   $t2, 0($zero)      -> mem[0] = 15
8C0B0000 // 4  : LW   $t3, 0($zero)      -> $t3 = 15
114B0001 // 5  : BEQ  $t2, $t3, 1        -> equal, taken: PC = (5+1)+1 = word 7
200C0063 // 6  : ADDI $t4, $zero, 99     -> SKIPPED by the branch
200D0007 // 7  : ADDI $t5, $zero, 7      -> $t5 = 7
0800000A // 8  : J    10                 -> jump to word 10 (byte 0x28)
200E0058 // 9  : ADDI $t6, $zero, 88     -> SKIPPED by the jump
200F004D // 10 : ADDI $t7, $zero, 77     -> $t7 = 77
0800000B // 11 : J    11                 -> infinite loop (halt)
